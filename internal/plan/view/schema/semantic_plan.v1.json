{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deployah.dev/schemas/plan/v1/schema.json",
  "title": "Deployah semantic plan v1",
  "description": "Machine-readable document produced by view.WriteJSON.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "header",
    "helmAction",
    "changes",
    "drift",
    "tasks",
    "chartCRDs",
    "summary"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "https://deployah.dev/schemas/plan/v1/schema.json"
    },
    "header": {
      "$ref": "#/$defs/Header"
    },
    "helmAction": {
      "type": "string",
      "enum": ["none", "install", "upgrade"]
    },
    "changes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ResourceChange"
      }
    },
    "drift": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Drift"
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Task"
      }
    },
    "chartCRDs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ChartCRD"
      }
    },
    "summary": {
      "$ref": "#/$defs/Summary"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "helmAction": {
            "const": "install"
          }
        },
        "required": ["helmAction"]
      },
      "then": {
        "properties": {
          "header": {
            "properties": {
              "freshInstall": {
                "const": true
              }
            },
            "required": ["freshInstall"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "header": {
            "properties": {
              "freshInstall": {
                "const": true
              }
            },
            "required": ["freshInstall"]
          }
        },
        "required": ["header"]
      },
      "then": {
        "properties": {
          "helmAction": {
            "const": "install"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "helmAction": {
            "const": "none"
          }
        },
        "required": ["helmAction"]
      },
      "then": {
        "properties": {
          "header": {
            "properties": {
              "freshInstall": {
                "not": {
                  "const": true
                }
              }
            }
          },
          "changes": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "header": {
            "properties": {
              "freshInstall": {
                "const": true
              }
            },
            "required": ["freshInstall"]
          }
        },
        "required": ["header"]
      },
      "then": {
        "properties": {
          "drift": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "helmAction": {
            "const": "upgrade"
          }
        },
        "required": ["helmAction"]
      },
      "then": {
        "properties": {
          "header": {
            "properties": {
              "freshInstall": {
                "not": {
                  "const": true
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "Header": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "project": {
          "type": "string"
        },
        "environment": {
          "type": "string"
        },
        "release": {
          "type": "string"
        },
        "namespace": {
          "type": "string"
        },
        "context": {
          "type": "string"
        },
        "revision": {
          "type": "integer"
        },
        "freshInstall": {
          "type": "boolean"
        }
      }
    },
    "ResourceChange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resource",
        "action",
        "before",
        "after",
        "fields"
      ],
      "properties": {
        "resource": {
          "$ref": "#/$defs/Resource"
        },
        "action": {
          "type": "string",
          "enum": ["create", "update", "delete"]
        },
        "before": {
          "$ref": "#/$defs/Snapshot"
        },
        "after": {
          "$ref": "#/$defs/Snapshot"
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FieldChange"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "action": {
                "const": "create"
              }
            },
            "required": ["action"]
          },
          "then": {
            "properties": {
              "before": {
                "type": "null"
              },
              "after": {
                "type": "object"
              },
              "fields": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "update"
              }
            },
            "required": ["action"]
          },
          "then": {
            "properties": {
              "before": {
                "type": "object"
              },
              "after": {
                "type": "object"
              },
              "fields": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "delete"
              }
            },
            "required": ["action"]
          },
          "then": {
            "properties": {
              "before": {
                "type": "object"
              },
              "after": {
                "type": "null"
              },
              "fields": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "Resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "kind", "namespace", "name"],
      "properties": {
        "apiVersion": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "namespace": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "generateName": {
          "type": "string"
        }
      }
    },
    "FieldChange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "op"],
      "properties": {
        "path": {
          "type": "string"
        },
        "op": {
          "type": "string",
          "enum": ["add", "remove", "replace"]
        },
        "before": true,
        "after": true
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "op": {
                "const": "add"
              }
            },
            "required": ["op"]
          },
          "then": {
            "required": ["after"],
            "not": {
              "required": ["before"]
            }
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "remove"
              }
            },
            "required": ["op"]
          },
          "then": {
            "required": ["before"],
            "not": {
              "required": ["after"]
            }
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "replace"
              }
            },
            "required": ["op"]
          },
          "then": {
            "required": ["before", "after"]
          }
        }
      ]
    },
    "Summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["create", "update", "delete", "total"],
      "properties": {
        "create": {
          "type": "integer",
          "minimum": 0
        },
        "update": {
          "type": "integer",
          "minimum": 0
        },
        "delete": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "Snapshot": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object"
        }
      ]
    },
    "Drift": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resource", "action", "previous", "live", "fields"],
      "properties": {
        "resource": {
          "allOf": [
            {
              "$ref": "#/$defs/Resource"
            },
            {
              "properties": {
                "name": {
                  "minLength": 1
                }
              },
              "required": ["name"],
              "not": {
                "required": ["generateName"]
              }
            }
          ]
        },
        "action": {
          "type": "string",
          "enum": ["modified", "missing", "unexpected"]
        },
        "previous": {
          "$ref": "#/$defs/Snapshot"
        },
        "live": {
          "$ref": "#/$defs/Snapshot"
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FieldChange"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "action": {
                "const": "modified"
              }
            },
            "required": ["action"]
          },
          "then": {
            "properties": {
              "previous": {
                "type": "object"
              },
              "live": {
                "type": "object"
              },
              "fields": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "missing"
              }
            },
            "required": ["action"]
          },
          "then": {
            "properties": {
              "previous": {
                "type": "object"
              },
              "live": {
                "type": "null"
              },
              "fields": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "unexpected"
              }
            },
            "required": ["action"]
          },
          "then": {
            "properties": {
              "previous": {
                "type": "null"
              },
              "live": {
                "type": "object"
              },
              "fields": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "Task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "phase",
        "action",
        "willRun",
        "definitions",
        "resources"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "phase": {
          "type": "string",
          "enum": ["preDeploy", "postDeploy", "schedule"]
        },
        "action": {
          "type": "string",
          "enum": ["unchanged", "create", "update", "delete"]
        },
        "willRun": {
          "type": "boolean"
        },
        "definitions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/HookDefinition"
          }
        },
        "resources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Resource"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "phase": {
                "const": "schedule"
              }
            },
            "required": ["phase"]
          },
          "then": {
            "properties": {
              "willRun": {
                "const": false
              },
              "definitions": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "phase": {
                "enum": ["preDeploy", "postDeploy"]
              }
            },
            "required": ["phase"]
          },
          "then": {
            "properties": {
              "resources": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "delete"
              }
            },
            "required": ["action"]
          },
          "then": {
            "properties": {
              "willRun": {
                "const": false
              }
            }
          }
        }
      ]
    },
    "HookDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resource",
        "action",
        "before",
        "after",
        "fields"
      ],
      "properties": {
        "resource": {
          "$ref": "#/$defs/Resource"
        },
        "action": {
          "type": "string",
          "enum": ["create", "update", "delete"]
        },
        "before": {
          "$ref": "#/$defs/Snapshot"
        },
        "after": {
          "$ref": "#/$defs/Snapshot"
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FieldChange"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "action": {
                "const": "create"
              }
            },
            "required": ["action"]
          },
          "then": {
            "properties": {
              "before": {
                "type": "null"
              },
              "after": {
                "type": "object"
              },
              "fields": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "update"
              }
            },
            "required": ["action"]
          },
          "then": {
            "properties": {
              "before": {
                "type": "object"
              },
              "after": {
                "type": "object"
              },
              "fields": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "delete"
              }
            },
            "required": ["action"]
          },
          "then": {
            "properties": {
              "before": {
                "type": "object"
              },
              "after": {
                "type": "null"
              },
              "fields": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "ChartCRD": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "index", "kind", "name", "lifecycle", "willProcess"],
      "properties": {
        "source": {
          "type": "string"
        },
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "kind": {
          "type": "string",
          "const": "CustomResourceDefinition"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "lifecycle": {
          "type": "string",
          "enum": ["process", "skip", "upgrade"]
        },
        "willProcess": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "lifecycle": {
                "const": "process"
              }
            },
            "required": ["lifecycle"]
          },
          "then": {
            "properties": {
              "willProcess": {
                "const": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "lifecycle": {
                "enum": ["skip", "upgrade"]
              }
            },
            "required": ["lifecycle"]
          },
          "then": {
            "properties": {
              "willProcess": {
                "const": false
              }
            }
          }
        }
      ]
    }
  }
}
