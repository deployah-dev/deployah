project: web
environment: prod
release: web
namespace: prod
completeness: complete

Actions:
  + create
  ~ update
  - delete
  -/+ replace

+ ConfigMap/prod/app create helm
+ apiVersion: v1
+ kind: ConfigMap
+ metadata:
+   name: app
+   namespace: prod
+ data:
+   key: v1
- ConfigMap/prod/old delete helm
- apiVersion: v1
- kind: ConfigMap
- metadata:
-   name: old
-   namespace: prod
- data:
-   key: v1
-/+ ConfigMap/prod/rs replace helm
  apiVersion: v1
  kind: ConfigMap
  metadata:
    name: rs
    namespace: prod
  data:
-   key: v1
+   key: v2
~ ConfigMap/prod/web update helm
  apiVersion: v1
  kind: ConfigMap
  metadata:
    name: web
    namespace: prod
  data:
-   key: v1
+   key: v2
Executions: none
Summary
  create: 1
  update: 1
  delete: 1
  replace: 1
  total: 4
